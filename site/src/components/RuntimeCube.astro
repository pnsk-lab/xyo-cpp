<!-- A six-face geometric model, rendered with CSS 3D: no mesh download or WebGL dependency.
     The meaningful runtime label remains available in the surrounding execution diagram. -->
<div class="runtime-cube" aria-hidden="true">
  <div class="cube-floor"></div>
  <div class="cube-float"><div class="cube-tilt"><div class="cube-body">
    <div class="cube-face cube-front"><span class="cube-face-index">XYO / RT</span><span class="cube-wordmark">xyo</span><span class="cube-face-detail">NATIVE RUNTIME</span></div>
    <div class="cube-face cube-back"><span class="cube-wordmark">xyo</span></div>
    <div class="cube-face cube-right"><span class="cube-circuit"></span><span>LLVM</span></div>
    <div class="cube-face cube-left"><span>SB3</span><span class="cube-circuit"></span></div>
    <div class="cube-face cube-top"><span class="cube-top-grid"></span><span>CORE</span></div>
    <div class="cube-face cube-bottom"></div>
  </div></div></div>
</div>
