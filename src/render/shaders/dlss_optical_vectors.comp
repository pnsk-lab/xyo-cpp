#version 450

// Vulkan optical flow produces R16G16_SFIXED5_NV on a coarse grid.
// A Vulkan transfer copies that VkImage into an SSBO packed as int16 x/y.
// This compute kernel decodes the signed fixed-point values and expands
// them to the per-render-pixel RG16F motion vector image required by DLSS.
// Optical flow INPUT=current, REFERENCE=previous => vectors current->previous.
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer OpticalFlowPacked {
    uint words[];
} flow;

layout(rg16f, binding = 1) writeonly uniform image2D dlssMotion;

// Optional NVIDIA NVOFA cost map. Four 8-bit costs per uint32.
// A non-zero threshold gates unreliable *local* motion to zero.
// This is a diagnostic policy: no guarantee of reducing DLSS ghosting.
layout(std430, binding = 2) readonly buffer FlowCosts {
    uint words[];
} costs;

// Optional geometry-derived motion for fully opaque sprites.
// mode=0: exact rigid translation; mode=1: inverse affine current quad ->
// prior image, using the SDL-rounded raster transform, guarded by source UV.
struct RigidRect {
    ivec4 bounds;
    vec4 delta;  // translation x/y, mode z=1 for affine
    vec4 previousX; // (m00,m01,m02, UV inset x)
    vec4 previousY; // (m10,m11,m12, UV inset y)
    vec4 currentU; // normalized current image coordinate from pixel x/y
    vec4 currentV;
    uint opaqueBits[512]; // 128x128 conservative bitmask, source UV space
};
layout(std430, binding = 3) readonly buffer RigidOverrides {
    RigidRect entries[];
} rigid;

layout(push_constant) uniform GridParams {
    int outputWidth;
    int outputHeight;
    int gridWidth;
    int gridHeight;
    int gridSize;
    int costLimit;
    int rigidCount;
    // Optical Flow sees both camera jitter and true scene motion.
    // Remove (previous jitter - current jitter) before NGX consumes MVs.
    float jitterDeltaX;
    float jitterDeltaY;
} params;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= params.outputWidth || p.y >= params.outputHeight)
        return;

    // The fixed-point values use 5 fractional bits: 1 raw count = 1/32px.
    ivec2 g = clamp(p / params.gridSize, ivec2(0),
                    ivec2(params.gridWidth - 1, params.gridHeight - 1));
    uint packed = flow.words[g.y * params.gridWidth + g.x];
    int vx = int(packed << 16) >> 16;
    int vy = int(packed) >> 16;
    if (params.costLimit > 0) {
        uint index = uint(g.y * params.gridWidth + g.x);
        uint word = costs.words[index / 4u];
        uint cost = (word >> ((index % 4u) * 8u)) & 255u;
        if (cost >= uint(params.costLimit)) {
            vx = 0;
            vy = 0;
        }
    }
    vec2 motion = vec2(float(vx), float(vy)) / 32.0 -
                  vec2(params.jitterDeltaX, params.jitterDeltaY);
    for (int i = 0; i < params.rigidCount; ++i) {
        ivec4 b = rigid.entries[i].bounds;
        if (p.x >= b.x && p.y >= b.y && p.x < b.z && p.y < b.w) {
            if (rigid.entries[i].delta.z < 0.5) {
                motion = rigid.entries[i].delta.xy;
                break;
            }
            // Half-pixel is the sampling center of the actual rasterized
            // SDL_RenderCopyEx quad; do not overwrite its AABB background.
            vec2 center = vec2(p) + vec2(0.5);
            vec3 q = vec3(center, 1.0);
            vec2 uv = vec2(dot(rigid.entries[i].currentU.xyz,q),
                           dot(rigid.entries[i].currentV.xyz,q));
            vec2 inset = vec2(rigid.entries[i].previousX.w,
                              rigid.entries[i].previousY.w);
            if (all(greaterThanEqual(uv,inset)) &&
                all(lessThanEqual(uv,vec2(1.0)-inset))) {
                // Only opt-in coverage masks can replace optical flow on
                // partly transparent costumes. The CPU precomputes each
                // 128x128 tile conservatively (source texel alpha 255 plus
                // a one-pixel guard border, including antialiasing).
                if (rigid.entries[i].delta.w > 0.5) {
                    ivec2 texel = clamp(ivec2(floor(uv*128.0)),
                                        ivec2(0), ivec2(127));
                    uint bitIndex = uint(texel.y * 128 + texel.x);
                    if ((rigid.entries[i].opaqueBits[bitIndex >> 5] &
                         (1u << (bitIndex & 31u))) == 0u)
                        continue;
                }
                vec2 previous = vec2(dot(rigid.entries[i].previousX.xyz,q),
                                     dot(rigid.entries[i].previousY.xyz,q));
                motion = previous-center;
                break;
            }
        }
    }
    imageStore(dlssMotion, p, vec4(motion, 0.0, 0.0));
}
