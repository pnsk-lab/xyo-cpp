// MATH-005: pure double SSA with a precise per-iteration rollback.
//
// Called only for statically proven pure scalar set/change loops. The
// parser excludes effectful reporters. Modulo uses the existing exact
// Scratch remainder lowerer; other operations use matching LLVM math calls.
// We never speculate
// past a scheduler boundary, and a NaN in any intermediate operation
// rejects the current iteration before any Scratch-visible writes occur.

// Guarded JIT-only optimization: exact pow(10, k/20) constant table.
// The table value is generated using the host libm pow() at compile time,
// and is used only when x has EXACTLY the same IEEE-754 value as k/20.
// Any other input, including NaN/infinities, calls the original pow.
// Shared table storage is constant and therefore thread-safe.
// Never select this path in AOT: the compilation host and execution
// target may use different libm implementations.
llvm::Value* emitFloatRepeatPow10Table(llvm::Value* x) {
    constexpr uint32_t n = 51;
    // One table PER LLVM module, not per reporter. Previously multiple
    // 10^ expressions in the same script emitted duplicate 51-element
    // globals and re-ran the host pow function for every occurrence.
    llvm::ArrayType* type = llvm::ArrayType::get(f64t, n);
    // Optional A/B to measure the previous table-per-reporter lowering.
    // Default is one immutable table per LLVM module.
    const char* duplicate = std::getenv("XYO_JIT_POW10_DUPLICATE_TABLE");
    auto* table = (duplicate && duplicate[0] == '1')
        ? nullptr : mod.getNamedGlobal("math007.pow10.table");
    if (!table) {
        std::vector<double> values;
        values.reserve(n);
        for (uint32_t i = 0; i < n; ++i)
            values.push_back(std::pow(10.0, double(i) / 20.0));
        auto* initializer = llvm::ConstantDataArray::get(
            lc, llvm::ArrayRef<double>(values));
        table = new llvm::GlobalVariable(
            mod, type, true, llvm::GlobalValue::PrivateLinkage,
            initializer, "math007.pow10.table");
        table->setUnnamedAddr(llvm::GlobalValue::UnnamedAddr::Global);
    }
    // Clamp before converting to an unsigned index. FPToUI on NaN or
    // outside the integer domain would be poison even if not selected.
    llvm::Value* inRange = b.CreateAnd(
        b.CreateFCmpOGE(x, cf64(0.0)),
        b.CreateFCmpOLE(x, cf64(2.5)));
    llvm::Value* safeArgument =
        b.CreateSelect(inRange, b.CreateFMul(x, cf64(20.0)), cf64(0.0));
    llvm::Value* index = b.CreateFPToUI(safeArgument, i32t);
    llvm::Value* back = b.CreateFDiv(
        b.CreateUIToFP(index, f64t), cf64(20.0));
    llvm::Value* hit = b.CreateAnd(
        inRange, b.CreateFCmpOEQ(x, back));
    BasicBlock* tableBlock = newBB("rep.pow10.table");
    BasicBlock* fallbackBlock = newBB("rep.pow10.libm");
    BasicBlock* mergeBlock = newBB("rep.pow10.merge");
    b.CreateCondBr(hit, tableBlock, fallbackBlock);
    b.SetInsertPoint(tableBlock);
    llvm::Value* pos = b.CreateInBoundsGEP(
        type, table, {ci32(0), index});
    llvm::Value* cached = b.CreateLoad(f64t, pos, "rep.pow10.cached");
    b.CreateBr(mergeBlock);
    b.SetInsertPoint(fallbackBlock);
    llvm::Value* computed = emitMathop(13, x);
    b.CreateBr(mergeBlock);
    b.SetInsertPoint(mergeBlock);
    auto* value = b.CreatePHI(f64t, 2, "rep.pow10.value");
    value->addIncoming(cached, tableBlock);
    value->addIncoming(computed, fallbackBlock);
    return value;
}

// MATH-008: exact integer-grid logarithm table generated by the SAME
// jsLog routine as xyo_log. The JIT host executes the project runtime
// library's jsLog, not glibc log; this preserves bit-identical values.
// Shared per LLVM Module, not emitted repeatedly for each math reporter.
llvm::Value* emitFloatRepeatLogTable(llvm::Value* x) {
    constexpr uint32_t kLast = 8192;
    constexpr uint32_t kSize = kLast + 1;
    // Experimental: avoid a 64 KiB LLVM global in EVERY JIT module.
    // JIT executes in this process, so an immutable process-lifetime table
    // may be referenced by its absolute address. Never emit this for AOT
    // or non-native pointer widths. The default module-local table remains
    // the portable fallback until startup/RSS parity is established.
    const char* shareSetting = std::getenv("XYO_JIT_LOG_SHARED_TABLE");
    const bool sharedTable = !aot && sizeof(void*) == 8 &&
        shareSetting && shareSetting[0] == '1';
    llvm::ArrayType* type = nullptr;
    llvm::GlobalVariable* table = nullptr;
    if (!sharedTable) {
        type = llvm::ArrayType::get(f64t, kSize);
        table = mod.getNamedGlobal("math008.log.integer.table");
        if (!table) {
            std::vector<double> values;
            values.reserve(kSize);
            // Slot 0 is unused because JS Math.log(0) returns -Infinity.
            values.push_back(0.0);
            for (uint32_t n = 1; n <= kLast; ++n)
                values.push_back(jsnum::jsLog(static_cast<double>(n)));
            auto* initializer = llvm::ConstantDataArray::get(
                lc, llvm::ArrayRef<double>(values));
            table = new llvm::GlobalVariable(
                mod, type, true, llvm::GlobalValue::PrivateLinkage,
                initializer, "math008.log.integer.table");
            table->setUnnamedAddr(llvm::GlobalValue::UnnamedAddr::Global);
        }
    }

    llvm::Value* inRange = b.CreateAnd(
        b.CreateFCmpOGE(x, cf64(1.0)),
        b.CreateFCmpOLE(x, cf64(double(kLast))));
    // Avoid poison from out-of-range/NaN FP-to-integer conversion: the
    // conversion always receives a safe double in the table domain.
    llvm::Value* guarded = b.CreateSelect(inRange, x, cf64(1.0));
    llvm::Value* index = b.CreateFPToUI(guarded, i32t);
    llvm::Value* exactInteger = b.CreateFCmpOEQ(
        x, b.CreateUIToFP(index, f64t));
    llvm::Value* hit = b.CreateAnd(inRange, exactInteger);

    BasicBlock* cachedBlock = newBB("rep.log.table");
    BasicBlock* fallbackBlock = newBB("rep.log.runtime");
    BasicBlock* mergeBlock = newBB("rep.log.merge");
    b.CreateCondBr(hit, cachedBlock, fallbackBlock);
    b.SetInsertPoint(cachedBlock);
    llvm::Value* address = nullptr;
    if (sharedTable) {
        // A native JIT module never outlives its hosting process. Keep
        // the data alive until process termination even if static objects
        // in the runtime/JIT are destroyed in an unexpected order.
        static const std::vector<double>* const hostTable = [] {
            auto* values = new std::vector<double>();
            values->reserve(kSize);
            values->push_back(0.0);
            for (uint32_t n = 1; n <= kLast; ++n)
                values->push_back(jsnum::jsLog(double(n)));
            return values;
        }();
        const auto addressBits = static_cast<uint64_t>(
            reinterpret_cast<uintptr_t>(hostTable->data()));
        llvm::Value* nativeBase = b.CreateIntToPtr(ci64(addressBits), ptrt);
        address = b.CreateInBoundsGEP(f64t, nativeBase, index);
    } else {
        address = b.CreateInBoundsGEP(type, table, {ci32(0), index});
    }
    llvm::Value* cached = b.CreateLoad(f64t, address, "rep.log.cached");
    b.CreateBr(mergeBlock);
    b.SetInsertPoint(fallbackBlock);
    llvm::Value* fallback = emitMathop(10, x);
    b.CreateBr(mergeBlock);
    b.SetInsertPoint(mergeBlock);
    auto* value = b.CreatePHI(f64t, 2, "rep.log.value");
    value->addIncoming(cached, cachedBlock);
    value->addIncoming(fallback, fallbackBlock);
    return value;
}

// MATH-008: the V8 fdlibm exp used by xyo_exp differs from glibc exp
// by 1 ULP for some tenths (for example 1.7, 2.1 and 4.7).
// Precompute through the SAME v8math::exp implementation at JIT compile
// time. Do not use in AOT: compilation/runtime libraries may differ.
llvm::Value* emitFloatRepeatExpTenths(llvm::Value* x) {
    constexpr uint32_t kLast = 50;
    constexpr uint32_t kCount = kLast + 1;
    llvm::ArrayType* type = llvm::ArrayType::get(f64t, kCount);
    llvm::GlobalVariable* table =
        mod.getNamedGlobal("math008.exp.tenths.table");
    if (!table) {
        std::vector<double> values;
        values.reserve(kCount);
        for (uint32_t n = 0; n <= kLast; ++n)
            values.push_back(v8math::exp(static_cast<double>(n) / 10.0));
        llvm::Constant* initializer = llvm::ConstantDataArray::get(
            lc, llvm::ArrayRef<double>(values));
        table = new llvm::GlobalVariable(
            mod, type, true, llvm::GlobalValue::PrivateLinkage,
            initializer, "math008.exp.tenths.table");
        table->setUnnamedAddr(llvm::GlobalValue::UnnamedAddr::Global);
    }

    llvm::Value* inRange = b.CreateAnd(
        b.CreateFCmpOGE(x, cf64(0.0)),
        b.CreateFCmpOLE(x, cf64(5.0)));
    llvm::Value* selected = b.CreateSelect(
        inRange, b.CreateFMul(x, cf64(10.0)), cf64(0.0));
    llvm::Value* index = b.CreateFPToUI(selected, i32t);
    llvm::Value* reconstructed = b.CreateFDiv(
        b.CreateUIToFP(index, f64t), cf64(10.0));
    llvm::Value* hit = b.CreateAnd(
        inRange, b.CreateFCmpOEQ(x, reconstructed));

    BasicBlock* cachedBlock = newBB("rep.exp.tenths");
    BasicBlock* fallbackBlock = newBB("rep.exp.runtime");
    BasicBlock* mergeBlock = newBB("rep.exp.merge");
    b.CreateCondBr(hit, cachedBlock, fallbackBlock);
    b.SetInsertPoint(cachedBlock);
    llvm::Value* address = b.CreateInBoundsGEP(
        type, table, {ci32(0), index});
    llvm::Value* cached = b.CreateLoad(f64t, address, "rep.exp.cached");
    b.CreateBr(mergeBlock);
    b.SetInsertPoint(fallbackBlock);
    llvm::Value* fallback = emitMathop(12, x);
    b.CreateBr(mergeBlock);
    b.SetInsertPoint(mergeBlock);
    auto* value = b.CreatePHI(f64t, 2, "rep.exp.value");
    value->addIncoming(cached, cachedBlock);
    value->addIncoming(fallback, fallbackBlock);
    return value;
}

// MATH-013: NaN facts are conditional on "valid so far". The entry
// guard proves every carried Number non-NaN. Each prior statement checks
// any potentially NaN intermediate before publishing a new value. A
// branch that already set valid=false bails out at the end of this
// speculative iteration, so using its value in subsequent expressions
// cannot make a bad iteration observable.
struct FloatRepeatNaNFacts {
    bool noNaN = false;
    bool nonnegative = false; // IEEE >= 0, includes -0
    bool literal = false;     // finite Number shadow only
    bool nonzeroLiteral = false;
};

// Every factor in an unbroken product must refer to the SAME numeric SSA
// variable. For any non-NaN x, x^n cannot be NaN, even for ±0 and ±Inf.
// This is stronger than simply knowing each operand is non-NaN:
// x*0 can be NaN for x=Inf, but x*x*x cannot.
std::optional<std::pair<unsigned, unsigned>> floatRepeatSameVarProduct(
    const NumericRepeatPlan& plan, int node) {
    using K = NumericRepeatExpr::Kind;
    const auto& e = plan.exprs[size_t(node)];
    if (e.kind == K::Variable)
        return std::pair<unsigned, unsigned>{e.variable, 1};
    if (e.kind != K::Mul || e.left < 0 || e.right < 0)
        return std::nullopt;
    const auto lhs = floatRepeatSameVarProduct(plan, e.left);
    const auto rhs = floatRepeatSameVarProduct(plan, e.right);
    if (!lhs || !rhs || lhs->first != rhs->first)
        return std::nullopt;
    return std::pair<unsigned, unsigned>{
        lhs->first, lhs->second + rhs->second};
}

FloatRepeatNaNFacts floatRepeatNaNFacts(
    const NumericRepeatPlan& plan, int node) {
    using K = NumericRepeatExpr::Kind;
    const auto& e = plan.exprs[size_t(node)];
    if (e.kind == K::Number)
        return {true, e.number >= 0.0, true, e.number != 0.0};
    if (e.kind == K::Variable)
        return {true, false, false, false};
    if (e.left < 0) return {};
    const auto a = floatRepeatNaNFacts(plan, e.left);
    if (!a.noNaN) return {};
    if (e.kind == K::Sqrt || (e.kind == K::MathOp && e.mathFn == 3))
        return {a.nonnegative, a.nonnegative, false, false};
    if (e.kind == K::Round)
        return {true, false, false, false};
    if (e.kind == K::MathOp) {
        switch (e.mathFn) {
        case 0: return {true, true, false, false}; // abs
        case 1: case 2: case 9: case 12: case 13:
            return {true, false, false, false};   // floor/ceil/atan/exp/pow10
        case 10: return {a.nonnegative, false, false, false}; // ln(x>=0)
        default: return {};
        }
    }
    if (e.right < 0) return {};
    const auto b = floatRepeatNaNFacts(plan, e.right);
    if (!b.noNaN) return {};
    switch (e.kind) {
    case K::Add:
        // Nonnegative + nonnegative cannot be Inf + (-Inf).
        return {a.nonnegative && b.nonnegative || a.literal || b.literal,
                a.nonnegative && b.nonnegative, false, false};
    case K::Sub:
        // At least one finite operand avoids Inf - Inf.
        return {a.literal || b.literal, false, false, false};
    case K::Mul: {
        const char* powerOption =
            std::getenv("XYO_JIT_FLOAT_NAN_POWER_FACTS");
        const bool extended = !powerOption || powerOption[0] != '0';
        const auto& left = plan.exprs[size_t(e.left)];
        const auto& right = plan.exprs[size_t(e.right)];
        // x*x is always >=0 and non-NaN even when x is +/-Inf.
        const bool square = left.kind == K::Variable &&
            right.kind == K::Variable && left.variable == right.variable;
        // Generalize to x*x*x and (x*x)*(x*x); this does NOT apply to
        // unrelated variables, where Infinity*0 would yield NaN.
        const auto repeated = extended
            ? floatRepeatSameVarProduct(plan, node) : std::nullopt;
        const bool safe = square || repeated.has_value() ||
            (a.literal && b.literal) ||
            a.nonzeroLiteral || b.nonzeroLiteral;
        const bool positivePower = repeated && (repeated->second % 2 == 0);
        return {safe, square || positivePower ||
                          (safe && a.nonnegative && b.nonnegative),
                false, false};
    }
    case K::Div: {
        const char* option = std::getenv("XYO_JIT_FLOAT_NAN_POWER_FACTS");
        // A finite, nonzero constant divided by any non-NaN value
        // yields a finite number, signed zero, or signed Infinity;
        // unlike 0/0 and Infinity/Infinity it cannot be NaN.
        const bool safe = b.nonzeroLiteral ||
            ((!option || option[0] != '0') && a.nonzeroLiteral);
        return {safe, safe && a.nonnegative && b.nonnegative,
                false, false};
    }
    default: return {};
    }
}

llvm::Value* emitFloatRepeatExpr(
    const NumericRepeatPlan& plan, int index,
    const std::vector<llvm::Value*>& values, llvm::Value*& valid) {
    using K = NumericRepeatExpr::Kind;
    const auto& expr = plan.exprs[size_t(index)];
    if (expr.kind == K::Variable) return values[expr.variable];
    if (expr.kind == K::Number) return cf64(expr.number);

    // Constant-fold only reporters whose compile-time implementation is
    // bit-for-bit identical to the runtime helper. In particular, xyo_log
    // and xyo_exp use fdlibm-compatible routines, NOT host std::log/exp.
    // A non-NaN constant remains an IEEE value, including +/-Infinity
    // and signed zero; Scratch-visible NaN cases use the original JIT
    // so the existing per-intermediate rollback remains authoritative.
    const char* foldFlag = std::getenv("XYO_JIT_MATH_CONST_FOLD");
    if (!aot && (!foldFlag || foldFlag[0] != '0') &&
        expr.kind == K::MathOp && expr.left >= 0) {
        const auto& input = plan.exprs[size_t(expr.left)];
        if (input.kind == K::Number && std::isfinite(input.number)) {
            double folded = std::numeric_limits<double>::quiet_NaN();
            switch (expr.mathFn) {
            case 10: folded = jsnum::jsLog(input.number); break;
            case 12: folded = v8math::exp(input.number); break;
            case 13: folded = std::pow(10.0, input.number); break;
            default: break;
            }
            if (!std::isnan(folded))
                return cf64(folded);
        }
    }

    llvm::Value* lhs = emitFloatRepeatExpr(
        plan, expr.left, values, valid);
    llvm::Value* result = nullptr;
    if (expr.kind == K::Sqrt || expr.kind == K::MathOp) {
        const char* table = std::getenv("XYO_JIT_POW10_TABLE");
        const char* logTable = std::getenv("XYO_JIT_LOG_TABLE");
        const char* expTable = std::getenv("XYO_JIT_EXP_TABLE");
        if (expr.kind == K::MathOp && expr.mathFn == 13 &&
            !aot && (!table || table[0] != '0'))
            result = emitFloatRepeatPow10Table(lhs);
        else if (expr.kind == K::MathOp && expr.mathFn == 10 &&
                 !aot && (!logTable || logTable[0] != '0'))
            result = emitFloatRepeatLogTable(lhs);
        else if (expr.kind == K::MathOp && expr.mathFn == 12 &&
                 !aot && (!expTable || expTable[0] != '0'))
            result = emitFloatRepeatExpTenths(lhs);
        else
            result = emitMathop(expr.kind == K::Sqrt ? 3 : expr.mathFn, lhs);
    } else if (expr.kind == K::Round) {
        result = emitJsRound(lhs);
    } else {
        llvm::Value* rhs = emitFloatRepeatExpr(
            plan, expr.right, values, valid);
        switch (expr.kind) {
        case K::Add: result = b.CreateFAdd(lhs, rhs); break;
        case K::Sub: result = b.CreateFSub(lhs, rhs); break;
        case K::Mul: result = b.CreateFMul(lhs, rhs); break;
        case K::Div: result = b.CreateFDiv(lhs, rhs); break;
        case K::Mod: {
            // Reuse canonical Scratch remainder, including signed zero.
            llvm::Value* boxed = emitArithNumeric(lhs, rhs, AOp::Mod);
            valid = b.CreateAnd(valid, b.CreateICmpNE(
                boxed, ci64(val::kNan)));
            result = emitToNumF64(boxed);
            break;
        }
        default: return cf64(std::numeric_limits<double>::quiet_NaN());
        }
    }
    // Preserve Scratch semantics even when NaN is subsequently used by
    // arithmetic (where casting NaN to Number can map it to zero).
    // Skip only those checks proven redundant by strict IEEE-754 facts.
    const char* nanFacts = std::getenv("XYO_JIT_FLOAT_NAN_FACTS");
    if ((nanFacts && nanFacts[0] == '0') ||
        !floatRepeatNaNFacts(plan, index).noNaN)
        valid = b.CreateAnd(valid, b.CreateFCmpORD(result, result));
    return result;
}

void emitFloatRepeatChunk(const NumericRepeatPlan& plan,
                          llvm::Value* remaining32,
                          AllocaInst* countdown, BasicBlock* loopHead) {
    BasicBlock* fast = newBB("rep.float.fast");
    BasicBlock* slow = newBB("rep.float.slow");
    llvm::Value* valid = b.CreateICmpNE(curYieldWarp, ci32(0));
    std::vector<llvm::Value*> initial;
    for (const auto& variable : plan.variables) {
        llvm::Value* bits = emitVarGet(variable.field);
        llvm::Value* number = b.CreateBitCast(bits, f64t);
        // All live scalars must be true Number tags, not strings, booleans
        // or NaN-boxes. Infinities and signed zeros are exact FP numbers.
        llvm::Value* plain = b.CreateICmpSLT(bits, ci64(val::kNan));
        valid = b.CreateAnd(
            valid, b.CreateAnd(plain, b.CreateFCmpORD(number, number)));
        initial.push_back(number);
    }
    b.CreateCondBr(valid, fast, slow);
    b.SetInsertPoint(fast);

    llvm::Value* ticks = b.CreateLoad(i64t, curYieldCnt);
    llvm::Value* untilPoll = yieldToPoll(ticks);
    llvm::Value* available = b.CreateZExt(remaining32, i64t);
    llvm::Value* chunk = b.CreateSelect(
        b.CreateICmpULT(available, untilPoll), available, untilPoll);

    BasicBlock* preheader = b.GetInsertBlock();
    BasicBlock* nativeHead = newBB("rep.float.head");
    BasicBlock* nativeExit = newBB("rep.float.exit");
    BasicBlock* bail = newBB("rep.float.bail");
    b.CreateBr(nativeHead);
    b.SetInsertPoint(nativeHead);
    auto* iteration = b.CreatePHI(i64t, 2, "rep.float.iter");
    iteration->addIncoming(ci64(0), preheader);

    std::vector<llvm::PHINode*> carries;
    std::vector<llvm::Value*> state;
    carries.reserve(initial.size());
    state.reserve(initial.size());
    for (llvm::Value* value : initial) {
        auto* phi = b.CreatePHI(f64t, 2, "rep.float.var");
        phi->addIncoming(value, preheader);
        carries.push_back(phi);
        state.push_back(phi);
    }

    // Compute exactly one Scratch iteration using plain IEEE doubles.
    // No speculative memory writes or user-visible reporter calls.
    llvm::Value* safeIteration = b.getInt1(true);
    for (const auto& statement : plan.stmts) {
        llvm::Value* next = emitFloatRepeatExpr(
            plan, statement.expression, state, safeIteration);
        if (statement.change) {
            next = b.CreateFAdd(state[statement.variable], next);
            safeIteration = b.CreateAnd(
                safeIteration, b.CreateFCmpORD(next, next));
        }
        state[statement.variable] = next;
    }
    BasicBlock* validTail = newBB("rep.float.tail");
    b.CreateCondBr(safeIteration, validTail, bail);

    const auto publish = [&](const std::vector<llvm::Value*>& values) {
        for (size_t i = 0; i < values.size(); ++i) {
            if (!plan.variables[i].written) continue;
            llvm::Value* value = values[i];
            llvm::Value* bits = b.CreateBitCast(value, i64t);
            const BlockField* field = plan.variables[i].field;
            if (PromotedVar* promoted = findPromoted(field);
                promoted && promoted->numeric)
                storeNumericPair(
                    *promoted, bits, value, b.getInt1(true));
            else
                emitVarSet(field, bits);
        }
    };

    b.SetInsertPoint(bail);
    // The rejected iteration has not run. Restore the prior PHI state,
    // advance only completed iterations, and let the original body execute
    // this one iteration, including its original yield/countdown semantics.
    std::vector<llvm::Value*> before(carries.begin(), carries.end());
    publish(before);
    b.CreateStore(
        b.CreateSub(remaining32, b.CreateTrunc(iteration, i32t)),
        countdown);
    b.CreateStore(b.CreateAdd(ticks, iteration), curYieldCnt);
    b.CreateBr(slow);

    b.SetInsertPoint(validTail);
    llvm::Value* nextIteration = b.CreateAdd(iteration, ci64(1));
    iteration->addIncoming(nextIteration, validTail);
    for (size_t i = 0; i < carries.size(); ++i)
        carries[i]->addIncoming(state[i], validTail);
    b.CreateCondBr(
        b.CreateICmpULT(nextIteration, chunk), nativeHead, nativeExit);

    b.SetInsertPoint(nativeExit);
    publish(state);
    b.CreateStore(
        b.CreateSub(remaining32, b.CreateTrunc(chunk, i32t)),
        countdown);
    emitSsaChunkScheduler(ticks, chunk, untilPoll, true);
    b.CreateBr(loopHead);
    b.SetInsertPoint(slow);
}
