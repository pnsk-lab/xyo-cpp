# バイナリファイルを C++ の byte 配列へ埋め込む（python に依存しない）。
#
# 関数として:
#   include(cmake/embed_binary.cmake)
#   xyo_embed_binary(<out.inc> <sym> <file> [<sym> <file> ...])
#
# ビルド時のカスタムコマンドとして（-P スクリプト）:
#   cmake -DXYO_EMBED_OUT=<out.inc> \
#         "-DXYO_EMBED_ARGS=<sym>;<file>;<sym>;<file>" \
#         -P cmake/embed_binary.cmake
#
# 出力は `static const unsigned char <sym>[]` と `static const unsigned int
# <sym>Size`。MSYS2 のように `python3` が POSIX パスを解釈する環境でも
# パス変換の心配が無いよう、CMake だけで完結させる。
function(xyo_embed_binary out)
    set(args ${ARGN})
    if(NOT out OR NOT args)
        message(FATAL_ERROR "xyo_embed_binary: <out.inc> <sym> <file> ... が必要")
    endif()
    file(WRITE "${out}" "// generated by cmake/embed_binary.cmake — do not edit\n")
    while(args)
        list(POP_FRONT args sym path)
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "xyo_embed_binary: ${path} が無い")
        endif()
        file(SIZE "${path}" size)
        file(READ "${path}" hex HEX)
        string(LENGTH "${hex}" hexlen)
        file(APPEND "${out}" "static const unsigned char ${sym}[] = {\n")
        # 4096 桁（=2048 バイト）ずつ整形する。文字列全体に正規表現をかけると
        # 大きいフォントで遅くなるため、16 バイト境界を保ったまま分割する。
        set(i 0)
        while(i LESS hexlen)
            math(EXPR n "${hexlen} - ${i}")
            if(n GREATER 4096)
                set(n 4096)
            endif()
            string(SUBSTRING "${hex}" ${i} ${n} chunk)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
            string(REGEX REPLACE "((0x..,){16})" "\\1\n    " chunk "${chunk}")
            file(APPEND "${out}" "    ${chunk}\n")
            math(EXPR i "${i} + ${n}")
        endwhile()
        file(APPEND "${out}" "};\nstatic const unsigned int ${sym}Size = ${size}u;\n")
    endwhile()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    xyo_embed_binary("${XYO_EMBED_OUT}" ${XYO_EMBED_ARGS})
endif()
