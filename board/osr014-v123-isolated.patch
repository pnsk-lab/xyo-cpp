@@ -0,0 +1,242 @@
+#!/usr/bin/env python3
+"""OSR-014: four lexical counted repeats and real native phase-4 yield.
+
+root repeat(3) -> warp procedure:
+  outer repeat(40_000):
+    set times=17
+    middle repeat(times-15):       # TWO private iterations
+      set times=17
+      deep repeat(times-15):       # TWO private iterations
+        set times=17
+        leaf repeat(times):        # SEVENTEEN private iterations
+          change sum by 2
+          set times=7             # mutates EVERY active TIMES reporter
+
+After a genuine phase4 native Fiber suspension, edit the leaf increment
+destination sum->branchCount. Both source proof and four exact native
+private counters are required before dropping the suspended Fiber.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import zipfile
+
+sys.path.insert(0, str(Path(__file__).parent))
+from jit_nested_warp_triple_yield_deopt import triple_fixture
+from jit_nested_warp_inflight_body_edit import (
+    run_mode, PROMOTION, RESTORE, EDIT,
+)
+
+QUAD_DEOPT = re.compile(
+    r"\[jit-osr-inflight\] deopt quad outer=([0-9.]+) "
+    r"middle=([0-9.]+) deep=([0-9.]+) leaf=([0-9.]+) "
+    r"source-changed=1"
+)
+
+
+def quad_fixture(path: Path, *, outer_count: int,
+                 fractional: bool = False,
+                 fifth_layer: bool = False) -> Path:
+    triple_fixture(path, outer_count=outer_count,
+                   middle_count=2, fractional=fractional)
+    with zipfile.ZipFile(path) as z:
+        data = {name: z.read(name) for name in z.namelist()}
+    project = json.loads(data["project.json"])
+    blocks = project["targets"][1]["blocks"]
+
+    # Existing 3-level structure:
+    # selected outer -> set times17 -> middle repeat ->
+    # set times17 -> leaf repeat -> change sum -> set times7.
+    leaf_id = "osr010_nested_fixed_inner"
+    leaf = blocks[leaf_id]
+    middle_prefix_id = leaf["parent"]
+    middle_prefix = blocks[middle_prefix_id]
+    middle_id = middle_prefix["parent"]
+    assert blocks[middle_id]["opcode"] == "control_repeat"
+    assert middle_prefix["next"] == leaf_id
+    extra_id = "osr014_deep_repeat"
+    extra_prefix_id = "osr014_deep_reset_times"
+    extra_times_id = "osr014_deep_times_variable"
+    extra_expr_id = "osr014_deep_times_minus15"
+    assert not any(name in blocks for name in
+                   (extra_id, extra_prefix_id, extra_times_id,
+                    extra_expr_id))
+    blocks[extra_times_id] = {
+        "opcode": "data_variable", "next": None,
+        "parent": extra_expr_id, "inputs": {},
+        "fields": {"VARIABLE": ["times", "v_times"]},
+        "topLevel": False, "shadow": False,
+    }
+    blocks[extra_expr_id] = {
+        "opcode": "operator_subtract", "next": None,
+        "parent": extra_id,
+        "inputs": {
+            "NUM1": [3, extra_times_id, [4, "0"]],
+            "NUM2": [1, [4, "15.5" if fractional else "15"]],
+        },
+        "fields": {}, "topLevel": False, "shadow": False,
+    }
+    blocks[extra_id] = {
+        "opcode": "control_repeat", "next": None,
+        "parent": middle_prefix_id,
+        "inputs": {
+            "TIMES": [3, extra_expr_id, [4, "2"]],
+            "SUBSTACK": [2, extra_prefix_id],
+        },
+        "fields": {}, "topLevel": False, "shadow": False,
+    }
+    blocks[extra_prefix_id] = {
+        "opcode": "data_setvariableto", "next": leaf_id,
+        "parent": extra_id,
+        "inputs": {"VALUE": [1, [4, "17"]]},
+        "fields": {"VARIABLE": ["times", "v_times"]},
+        "topLevel": False, "shadow": False,
+    }
+    middle_prefix["next"] = extra_id
+    leaf["parent"] = extra_prefix_id
+
+    if fifth_layer:
+        # The 5th counted loop is semantically valid Scratch, but cannot
+        # be represented by this explicitly bounded phase4 ABI.
+        body_id = leaf["inputs"]["SUBSTACK"][1]
+        assert blocks[body_id]["opcode"] == "data_changevariableby"
+        fifth_id = "osr014_fifth_refused_repeat"
+        assert fifth_id not in blocks
+        blocks[fifth_id] = {
+            "opcode": "control_repeat", "next": None,
+            "parent": leaf_id,
+            "inputs": {
+                "TIMES": [1, [4, "2"]],
+                "SUBSTACK": [2, body_id],
+            },
+            "fields": {}, "topLevel": False, "shadow": False,
+        }
+        leaf["inputs"]["SUBSTACK"] = [2, fifth_id]
+        blocks[body_id]["parent"] = fifth_id
+
+    data["project.json"] = json.dumps(
+        project, ensure_ascii=False, separators=(",", ":")
+    ).encode()
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
+        for name, contents in data.items():
+            z.writestr(name, contents)
+    return path
+
+
+def verify(harness: Path, project: Path, *, outer_count: int,
+           fractional: bool, counted: bool) -> None:
+    leaf_count = 18 if fractional else 17
+    total = 3 * outer_count * 2 * 2 * leaf_count * 2
+    os.environ["XYO_OSR_EXPECTED_SUM"] = str(total)
+    os.environ["XYO_OSR_EXPECTED_TIMES"] = "s:7"
+    baseline, _ = run_mode(harness, project, "baseline", count=counted)
+    assert baseline["v_sum"] == f"n:{total}", baseline
+    assert baseline["v_branchCount"] == "s:0", baseline
+
+    disabled, trace = run_mode(harness, project, "disabled", count=counted)
+    assert disabled == baseline, (disabled, baseline)
+    assert not PROMOTION.search(trace), trace[-1600:]
+    quad_disabled, no_quad_trace = run_mode(
+        harness, project, "quad-disabled", count=counted
+    )
+    assert quad_disabled == baseline, (quad_disabled, baseline)
+    assert not PROMOTION.search(no_quad_trace), (
+        "four-depth native OSR accepted with QUAD opt-in disabled",
+        no_quad_trace[-1600:],
+    )
+    print("PASS QUAD opt-in OFF with earlier triple/dynamic flags ON: "
+          "no native promotion", flush=True)
+
+    positive, trace = run_mode(harness, project, "positive", count=counted)
+    assert positive == baseline, (positive, baseline)
+    promotions, restores = (
+        len(PROMOTION.findall(trace)), len(RESTORE.findall(trace))
+    )
+    assert 1 <= promotions <= 3 and restores == promotions, (
+        promotions, restores, trace[-2800:]
+    )
+    assert "yielding inner repeat accepted" in trace, trace[-2800:]
+    print(f"PASS positive: native={promotions}/{restores}, "
+          f"total={total}, counted={counted}, "
+          f"blocks={baseline.get('__block_count', 'disabled')}", flush=True)
+
+    for mode in ("guarded", "guarded-late"):
+        state, trace = run_mode(harness, project, mode, count=counted)
+        edits = EDIT.findall(trace)
+        assert len(edits) == 1, (mode, edits, trace[-3200:])
+        leaf_remaining, flag, committed, _, observed = edits[0]
+        assert flag == "1", (mode, edits)
+        assert int(observed) >= (4 if mode.endswith("-late") else 1)
+        assert 0 < float(committed) < total
+        checkpoints = QUAD_DEOPT.findall(trace)
+        assert len(checkpoints) == 1, (mode, trace[-3600:])
+        outer, middle, deep, leaf = map(float, checkpoints[0])
+        assert 0 <= outer < outer_count, (outer, outer_count)
+        assert 0 <= middle < 2, middle
+        assert 0 <= deep < 2, deep
+        assert 0 <= leaf < leaf_count, leaf
+        assert leaf == float(leaf_remaining)
+        promotions, restores = (
+            len(PROMOTION.findall(trace)), len(RESTORE.findall(trace))
+        )
+        assert 1 <= promotions <= 3 and restores == promotions-1, (
+            mode, promotions, restores, trace[-2800:]
+        )
+        sum_value = int(state["v_sum"][2:])
+        branch = int(state["v_branchCount"][2:])
+        assert sum_value == int(float(committed)), (
+            mode, sum_value, committed
+        )
+        assert branch == total-sum_value, (mode, branch, total, sum_value)
+        for key, value in baseline.items():
+            if key not in ("v_sum", "v_branchCount"):
+                assert state[key] == value, (
+                    mode, key, state[key], value
+                )
+        print(f"PASS {mode}: native={promotions} deopt-phase4=1 "
+              f"counts={checkpoints[0]}, sum={sum_value} "
+              f"redirected={branch}", flush=True)
+
+    # The 5th layer may be executed by Interpreter but must NOT be
+    # passed to an OSR backend with an insufficient source-state schema.
+    small_outer = 200
+    fifth = quad_fixture(
+        project.parent / "fifth-repeat-rejected.sb3",
+        outer_count=small_outer, fractional=False, fifth_layer=True,
+    )
+    os.environ["XYO_OSR_EXPECTED_SUM"] = str(
+        3 * small_outer * 2 * 2 * 17 * 2 * 2
+    )
+    expected, _ = run_mode(harness, fifth, "baseline", count=counted)
+    actual, trace = run_mode(harness, fifth, "rejected", count=counted)
+    assert actual == expected, (actual, expected)
+    assert not PROMOTION.search(trace), trace[-2900:]
+    print("PASS 5th nested counted repeat rejected; exact Interpreter "
+          "parity", flush=True)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--harness", type=Path, required=True)
+    p.add_argument("--out", type=Path, required=True)
+    p.add_argument("--outer-count", type=int, default=40_000)
+    p.add_argument("--fractional", action="store_true")
+    p.add_argument("--without-block-count", action="store_true")
+    a = p.parse_args()
+    a.out.mkdir(parents=True, exist_ok=True)
+    project = quad_fixture(
+        a.out / ("four-layer-fractional.sb3" if a.fractional
+                 else "four-layer-integer.sb3"),
+        outer_count=a.outer_count, fractional=a.fractional,
+    )
+    verify(a.harness, project, outer_count=a.outer_count,
+           fractional=a.fractional, counted=not a.without_block_count)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/platform/nested_warp_quad_yield_deopt_smoke.cpp b/tests/platform/nested_warp_quad_yield_deopt_smoke.cpp
new file mode 100644
index 0000000..8c3bc3b
--- /dev/null
+++ b/tests/platform/nested_warp_quad_yield_deopt_smoke.cpp
@@ -0,0 +1,361 @@
+// OSR-014: FOUR counted repeats, THREE incomplete lexical source
+// ancestors. A real deepest native Fiber yield restores four counters.
+ // OSR-013: triple counted-repeat source path with TWO incomplete
+// ancestors. The real deepest native Fiber yield restores all three
+// source counters and original Interpreter procedure/GC frames.
+// The dynamic TIMES reporters for middle and leaf are mutable.
+// OSR-012: variable/expression TIMES changed after native inner repeat
+// entry. The native private loop counter MUST not be reset by reporter
+// reevaluation or source-edit deoptimization at a real phase2 yield.
+// while OSR-008 emits a scheduler yield only at the outer body boundary.
+// Edit the nested changevariableby target after native Fiber suspension.
+// Edit a *currently executing* Scratch counted-repeat body AFTER a real
+// native Fiber yield, before any more compiled instructions run. The old
+// body writes sum; the edited source writes branchCount. resetCache()
+// rebuilds Interpreter BlockCached fields just as the real editor does.
+// Without the in-flight guard, stale LLVM keeps writing sum. With the guard,
+// the original Interpreter frame must execute the new source from its exact
+// saved loop counter, without replaying any committed effects.
+// Tests perform the edit after either the first or fourth native yield.
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include "../../src/engine/runtime.hpp"
+#include "../../src/engine/thread.hpp"
+#include "../../src/ir/scratch_pipeline.hpp"
+#include "../../src/ir/scratch_source_digest.hpp"
+#include "../../src/jit/jit.hpp"
+#include "../../src/load/sb3.hpp"
+#include "../../src/model/target.hpp"
+#include "../../src/core/sstr.hpp"
+
+#include <cassert>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <iterator>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+using namespace xyo;
+
+namespace {
+
+void env(const char* name, const char* value) {
+#if defined(_WIN32)
+    assert(_putenv_s(name, value) == 0);
+#else
+    assert(::setenv(name, value, 1) == 0);
+#endif
+}
+
+std::string canonical(Value v) {
+    if (v.isBool()) return v.asBool() ? "true" : "false";
+    if (v.isString()) return "s:" + SStr::toUtf8(v.asStrPtr());
+    if (v.isNumber()) {
+        std::ostringstream out;
+        out << std::setprecision(17) << v.asNumberUnchecked();
+        return "n:" + out.str();
+    }
+    std::ostringstream out;
+    out << "raw:" << std::hex << v.bits;
+    return out.str();
+}
+
+void check(bool condition, const char* reason) {
+    if (condition) return;
+    std::cerr << "FAIL " << reason << '\n';
+    std::exit(2);
+}
+
+Target* findBench(Runtime& rt) {
+    for (Target* target : rt.targets)
+        if (target && target->sprite &&
+            target->sprite->name == u"Bench")
+            return target;
+    return nullptr;
+}
+
+Block* runningSumIncrement(Blocks& blocks) {
+    for (auto& [id, node] : blocks.allBlocks()) {
+        if (node.opcode != "data_changevariableby") continue;
+        const auto field = node.fields.find("VARIABLE");
+        if (field != node.fields.end() && field->second.id == "v_sum")
+            return &node;
+    }
+    return nullptr;
+}
+
+bool replaceActiveBody(Thread& thread, const CompiledScript& ready) {
+    Blocks& blocks = *thread.blockContainer;
+    const Block* root = blocks.getBlock(thread.topBlock);
+    check(root && ready.nestedOsrEntry, "missing source root/LLVM");
+    Block* running = runningSumIncrement(blocks);
+    check(running, "missing running sum increment in procedure body");
+    auto field = running->fields.find("VARIABLE");
+    check(field != running->fields.end(), "missing VARIABLE field");
+    const auto initial = ir::ScratchCompilationUnit::capture(blocks, root);
+    check(initial.valid(), "invalid pre-edit Scratch source");
+    const auto before = ir::scratchSourceDigest(initial);
+    const uint64_t revision = blocks.revision();
+    // Real source edit: the interpreter must create fresh BlockCached
+    // ArgValues; a silent field edit without resetCache would leave the
+    // interpreter itself executing the old target variable.
+    field->second.id = "v_branchCount";
+    blocks.resetCache();
+    const auto updated = ir::ScratchCompilationUnit::capture(blocks, root);
+    check(updated.valid(), "invalid updated Scratch source");
+    check(blocks.revision() != revision,
+          "real editor edit must advance source revision");
+    check(ir::scratchSourceDigest(updated) != before,
+          "active-body edit did not change source digest");
+    std::cerr << "[osr-body-edit] changed id=" << running->id
+              << " v_sum->v_branchCount revision=" << revision
+              << "->" << blocks.revision() << '\n';
+    return true;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc != 3) {
+        std::cerr << "usage: body-edit <project.sb3> "
+                     "<baseline|positive|unguarded|guarded|unguarded-late|guarded-late>\n";
+        return 2;
+    }
+    const std::string mode = argv[2];
+    const char* expectedText = std::getenv("XYO_OSR_EXPECTED_SUM");
+    const double expectedSum = expectedText ?
+        std::strtod(expectedText, nullptr) : 48000000.0;
+    check(std::isfinite(expectedSum) && expectedSum > 0,
+          "invalid expected native/interpreter sum");
+    const bool baseline = mode == "baseline";
+    const bool rejected = mode == "rejected";
+    const bool disabled = mode == "disabled";
+    const bool quadDisabled = mode == "quad-disabled";
+    const bool late = mode == "unguarded-late" ||
+                      mode == "guarded-late";
+    const bool edited = mode == "unguarded" || mode == "guarded" ||
+                        late;
+    const bool proof = !baseline;
+    const bool inFlight = rejected || disabled || quadDisabled ||
+        mode == "positive" || mode == "guarded" ||
+        mode == "guarded-late";
+    const uint32_t nativeYieldsBeforeEdit = late ? 4 : 1;
+    check(baseline || rejected || disabled || quadDisabled || edited ||
+          mode == "positive",
+          "unknown test mode");
+    env("XYO_JIT_MODE", baseline ? "off" : "hotspot");
+    env("XYO_JIT_ASYNC", "1");
+    env("XYO_JIT_OSR", "1");
+    env("XYO_JIT_OSR_NESTED", "1");
+    env("XYO_JIT_OSR_NESTED_DEEP", "1");
+    env("XYO_JIT_OSR_NESTED_PARENT_REPEAT", "1");
+    env("XYO_JIT_OSR_NESTED_ARG_READS", "1");
+    env("XYO_JIT_OSR_NESTED_DIRECT_ARGS", "1");
+    env("XYO_JIT_OSR_NESTED_HOIST_ARGS", "1");
+    env("XYO_JIT_OSR_NESTED_SOURCE_PROOF", proof ? "1" : "0");
+    env("XYO_JIT_OSR_NESTED_INFLIGHT_DEOPT", inFlight ? "1" : "0");
+    env("XYO_JIT_OSR_NESTED_INNER_BOUNDED", "0");
+    env("XYO_JIT_OSR_NESTED_INNER_YIELD_DEOPT",
+        inFlight && !disabled ? "1" : "0");
+    env("XYO_JIT_OSR_NESTED_INNER_DYNAMIC",
+        !baseline && !disabled ? "1" : "0");
+    env("XYO_JIT_OSR_NESTED_TRIPLE_YIELD",
+        !baseline && !disabled ? "1" : "0");
+    env("XYO_JIT_OSR_NESTED_QUAD_YIELD",
+        !baseline && !disabled && !quadDisabled ? "1" : "0");
+    env("XYO_JIT_OSR_TIMING", "1");
+    env("XYO_JIT_OSR_NESTED_TRACE", "1");
+    env("XYO_PAR", "0");
+    env("XYO_PARFOR", "0");
+    env("XYO_GPU", "0");
+
+    setJitMode(baseline ? JitMode::Off : JitMode::HotSpot);
+    std::ifstream file(argv[1], std::ios::binary);
+    check(bool(file), "cannot open fixture");
+    std::vector<uint8_t> source{
+        std::istreambuf_iterator<char>(file),
+        std::istreambuf_iterator<char>()
+    };
+    check(!source.empty(), "empty fixture");
+
+    Runtime rt;
+    const auto loaded = loadSb3File(rt, source.data(), source.size());
+    check(loaded.ok, "loadSb3File failed");
+    Target* target = findBench(rt);
+    check(target && target->blocks, "Bench target missing");
+    // The timeout is a public runtime scheduler configuration, not an
+    // instrumentation hook. It makes an actual warp Fiber suspension occur
+    // in a small GC/string test rather than requiring a 500ms CPU burst.
+    // Use normal test warp timing. On very fast native executions the
+    // fourth observed yield may occur in a later parent invocation.
+    // The verifier accounts for each completed native caller suffix.
+    rt.warpTimeMs = baseline ? 500.0 : 0.0;
+    rt.greenFlag();
+
+    bool changed = false;
+    bool published = false;
+    bool sawNativeYield = false;
+    bool sawNativeInnerYield = false;
+    double deoptCheckpoint = -1.0;
+    double sumAtEdit = -1.0;
+    uint64_t countAtEdit = 0;
+    uint64_t observedNativeYields = 0;
+    double lastObservedSum = -1;
+    uint64_t iterations = 0;
+    constexpr uint64_t maxSteps = 200000;
+    for (; iterations < maxSteps; ++iterations) {
+        if (rt.threads.empty()) break;
+        // The host may edit the live source ONLY while the native Fiber
+        // is suspended at xyo_yield. It is a serial scheduler safe point.
+        if (!changed && !baseline) {
+            for (Thread* t : rt.threads) {
+                if (!t || !t->jitCtx || !t->fiber ||
+                    !t->isCompiled || !t->nestedOsrActive ||
+                    !t->topBlockPtr || !t->blockContainer)
+                    continue;
+                const auto* candidate = static_cast<const CompiledScript*>(
+                    t->compiled);
+                if (!candidate || !candidate->nestedOsrEntry ||
+                    candidate->nestedOsrInFlightGuard != inFlight)
+                    continue;
+                sawNativeYield = true;
+                published = true;
+                if (inFlight && t->jitCtx->nestedOsrDeoptPhase == 4)
+                    sawNativeInnerYield = true;
+                if (inFlight) {
+                    // Only a REAL inner-body-completed Fiber suspension
+                    // is the verified source edit injection site.
+                    if (t->jitCtx->nestedOsrDeoptPhase != 4)
+                        continue;
+                    check(t->jitCtx->nestedOsrDeoptReady == 1,
+                          "native inner yield missing safe checkpoint");
+                    check(t->jitCtx->nestedOsrDeoptInnerRemaining >= 0.0,
+                          "negative nested source loop checkpoint");
+                    check(t->jitCtx->nestedOsrDeoptDeepRemaining >= 0.0,
+                          "negative deepest source loop checkpoint");
+                    check(t->jitCtx->nestedOsrDeoptFourthRemaining >= 0.0,
+                          "negative fourth source loop checkpoint");
+                    deoptCheckpoint =
+                        t->jitCtx->nestedOsrDeoptFourthRemaining;
+                }
+                if (edited) {
+                    const Variable* sum =
+                        target->lookupVariableById("v_sum");
+                    check(sum && sum->value.isNumber(),
+                          "cannot snapshot sum at native yield");
+                    // A reporter that determines inner TIMES was
+                    // overwritten by a completed INNER body, before the
+                    // active native Fiber suspension. The current loop
+                    // must continue with its ORIGINAL private counter.
+                    const Variable* times =
+                        target->lookupVariableById("v_times");
+                    check(times && canonical(times->value) == "s:7",
+                          "TIMES variable did not change inside inner body");
+                    const double currentSum =
+                        sum->value.asNumberUnchecked();
+                    if (currentSum <= lastObservedSum) continue;
+                    lastObservedSum = currentSum;
+                    ++observedNativeYields;
+                    if (observedNativeYields < nativeYieldsBeforeEdit)
+                        continue;
+                    sumAtEdit = currentSum;
+                    countAtEdit =
+                        rt.executedBlocks.load(std::memory_order_relaxed);
+                    changed = replaceActiveBody(*t, *candidate);
+                    rt.warpTimeMs = 500.0;
+                    std::cerr
+                        << "[osr-body-edit] suspended remaining="
+                        << deoptCheckpoint << " guard=" << int(inFlight)
+                        << " committed-sum="
+                        << static_cast<uint64_t>(sumAtEdit)
+                        << " blocks=" << countAtEdit
+                        << " yields=" << observedNativeYields << '\n';
+                    break;
+                }
+            }
+        }
+        rt.step();
+    }
+    check(iterations < maxSteps, "runtime exceeded step budget");
+    if (!baseline && !rejected && !disabled && !quadDisabled) {
+        check(published && sawNativeYield,
+              "native LLVM never yielded at an observable safe point");
+        if (inFlight)
+            check(sawNativeInnerYield,
+                  "LLVM never yielded inside the native inner repeat");
+    }
+    if (rejected || disabled || quadDisabled) check(!sawNativeYield,
+                       "unapproved nested loop was promoted");
+    if (edited) check(changed, "source edit was not injected at a native yield");
+    check(rt.threads.empty(), "project left unfinished threads");
+    const auto number = [&](const char* id) {
+        const Variable* v = target->lookupVariableById(id);
+        if (!v || !v->value.isNumber()) {
+            std::cerr << "missing/non-numeric variable id=" << id
+                      << " found=" << int(v != nullptr)
+                      << " value=" << (v ? canonical(v->value) : "(none)")
+                      << " steps=" << iterations << '\n';
+            check(false, "missing numeric result");
+        }
+        return v->value.asNumberUnchecked();
+    };
+    if (inFlight && edited) {
+        check(sumAtEdit > 0 && sumAtEdit < expectedSum,
+              "edit did not occur after partial native execution");
+        check(number("v_sum") == sumAtEdit,
+              "post-deopt interpreter used stale native variable field");
+        check(number("v_branchCount") == expectedSum - sumAtEdit,
+              "remaining loop work did not use edited branchCount");
+    } else if (edited) {
+        check(number("v_sum") > sumAtEdit,
+              "without guard, native loop unexpectedly respected edit");
+    } else {
+        check(number("v_sum") == expectedSum, "incorrect original sum");
+        const Variable* branch = target->lookupVariableById("v_branchCount");
+        check(branch && canonical(branch->value) == "s:0",
+              "unexpected branchCount");
+    }
+    if (edited)
+        check(number("v_sum") + number("v_branchCount") == expectedSum,
+              "missing/duplicated increments across native/interpreter split");
+    check(number("v_entered") == 3.0, "outer repeat restarted");
+    check(number("v_afterInner") == 3.0,
+          "caller suffix replay/missing");
+    // Scratch assignments can preserve string literal Value tags.
+    const auto literal = [&](const char* id) {
+        const Variable* v = target->lookupVariableById(id);
+        check(v != nullptr, "missing literal result");
+        return canonical(v->value);
+    };
+    check(literal("v_done") == "s:1", "root script unfinished");
+    const char* expectedTimes = std::getenv("XYO_OSR_EXPECTED_TIMES");
+    check(literal("v_times") == (expectedTimes
+              ? std::string(expectedTimes) : std::string("s:17")),
+          "dynamic repeat TIMES final value mismatch");
+
+    std::map<std::string, std::string> results;
+    if (rt.blockCountEnabled)
+        results["__block_count"] =
+            "n:" + std::to_string(
+                rt.executedBlocks.load(std::memory_order_relaxed));
+    for (const auto& [id, variable] : target->variables)
+        if (variable.type != Variable::kListType)
+            results[id] = canonical(variable.value);
+    std::cout << "SPLIT sum-at-edit=" << sumAtEdit
+              << " count-at-edit=" << countAtEdit << '\n';
+    std::cout << "TEST mode=" << mode << " steps=" << iterations
+              << " nested-yield=" << int(sawNativeInnerYield)
+              << " edited=" << int(changed)
+              << " native-yield=" << int(sawNativeYield)
+              << " checkpoint=" << deoptCheckpoint << '\n';
+    for (const auto& [id, value] : results)
+        std::cout << "STATE " << id << "=" << value << '\n';
+    return 0;
+}
