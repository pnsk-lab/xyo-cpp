+def runtime_abi_missing() -> list[str]:
+    # Check real C++ declarations, not comments or name-only references.
+    # The compiler/build is the final authority; this is a fast preflight
+    # against accidentally publishing 38 tests on an older runtime.
+    header = JIT_HEADER.read_text(encoding="utf-8")
+    return [
+        name for name, type_name in OSR_RUNTIME_ABI.items()
+        if not re.search(
+            r"^\s*" + re.escape(type_name) + r"\s+" + name + r"\s*(?:=|;)",
+            header,
+            re.MULTILINE,
+        )
+    ]
 
 
